VITE_SOCKET_URL=http://localhost:3001
SUMOLOGIC_COLLECTOR=
ADMIN_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
IA_PLAYER_PER_GAME=3
MIN_PLAYER=2

#   IA_PLAYER_PER_GAME - total players targeted per game, AIs fill the remaining slots (prod default: 0)
#   MIN_PLAYER         - humans required in the lobby before the countdown can start (default: 6)
#   TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID - both set: ping that chat when a player starts waiting in the lobby (blank = off)
#   WEBAUTHN_RP_ID / WEBAUTHN_ORIGIN - the domain and origin(s, comma-separated) the game page is served from (prod: bataille.ovh / https://bataille.ovh);
#                        passkeys are bound to them, so a mismatch makes every sign-in fail
